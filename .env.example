# Get a free key at https://build.nvidia.com  (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your-key-here

# Optional — powers the Claude Opus 5 / Claude Sonnet 5 models in the picker.
# Get a key at https://console.anthropic.com  (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — without this, memories.json is used (fine locally, but wiped on
# redeploy/restart on hosts with an ephemeral filesystem, e.g. Render free tier).
# Set this to a free Postgres project's "Connection Pooling" URI (e.g. from
# https://supabase.com) so remembered facts persist permanently instead.
DATABASE_URL=
